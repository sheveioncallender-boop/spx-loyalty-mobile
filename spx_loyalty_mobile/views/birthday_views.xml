<odoo>
  <record id="birthday_settings_list" model="ir.ui.view">
    <field name="name">spx.birthday.settings.list</field><field name="model">website</field><field name="priority">90</field><field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
    <field name="arch" type="xml">
      <list create="0" delete="0">
        <field name="name"/><field name="company_id"/><field name="spx_birthday_enabled"/>
        <field name="currency_id" column_invisible="True"/><field name="spx_birthday_amount"/>
        <field name="spx_birthday_days"/><field name="spx_birthday_audience"/>
        <button name="action_spx_birthday_customers" type="object" string="Customer birthdays"/>
        <button name="action_spx_issue_birthday" type="object" string="Issue credit"/>
      </list>
    </field>
  </record>
  <record id="birthday_settings_form" model="ir.ui.view">
    <field name="name">spx.birthday.settings.form</field><field name="model">website</field><field name="priority">90</field><field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
    <field name="arch" type="xml">
      <form string="Birthday credit settings" create="0" delete="0">
        <header>
          <button name="action_spx_birthday_customers" type="object" string="Customer birthdays" class="btn-primary"/>
          <button name="action_spx_issue_birthday" type="object" string="Issue credit"/>
          <button name="action_spx_birthday_history" type="object" string="Issued credits"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
          <group>
            <group string="Birthday credit">
              <field name="company_id" readonly="1"/>
              <field name="spx_birthday_enabled"/>
              <field name="spx_birthday_program_id" options="{'no_create': True}"/>
              <field name="currency_id" invisible="1"/>
              <field name="spx_birthday_amount"/><field name="spx_birthday_days"/>
              <field name="spx_birthday_message"/>
            </group>
            <group string="Customer birthdays">
              <field name="spx_birthday_audience"/>
              <field name="spx_birthday_field_id" options="{'no_create': True}"/>
              <field name="spx_member_timezone"/>
            </group>
          </group>
          <p>Customer birthdays reads existing individual contacts, including people who have not joined the app. Select an existing contact Date field if you already store birthdays there. When it is empty, the signup Birthday field is used. No contact or birthday is duplicated.</p>
          <p>Automatic credit is issued on the local birthday, once per customer and company per calendar year. Choose whether to include all customer contacts or verified app members only. The issue date counts as day one of validity. Default amount and validity changes affect future awards only.</p>
          <p>Use a separate native Gift Card program with no sale trigger products. Open an issued card to change its expiry, or use Odoo’s Update Balance action to adjust its remaining credit. POS payment, discounts and accounting remain native.</p>
        </sheet>
      </form>
    </field>
  </record>
  <record id="birthday_settings_action" model="ir.actions.act_window">
    <field name="name">Birthday Settings</field><field name="res_model">website</field>
    <field name="view_mode">list,form</field><field name="domain">[('spx_mobile_enabled', '=', True)]</field>
  </record>
  <record id="birthday_settings_action_list" model="ir.actions.act_window.view">
    <field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="birthday_settings_list"/><field name="act_window_id" ref="birthday_settings_action"/>
  </record>
  <record id="birthday_settings_action_form" model="ir.actions.act_window.view">
    <field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="birthday_settings_form"/><field name="act_window_id" ref="birthday_settings_action"/>
  </record>
  <record id="birthday_customer_list" model="ir.ui.view">
    <field name="name">spx.birthday.customer.list</field><field name="model">res.partner</field><field name="priority">90</field><field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
    <field name="arch" type="xml">
      <list create="0" delete="0" decoration-info="spx_birthday_countdown == 0">
        <header><button name="%(birthday_settings_action)d" type="action" string="Birthday settings" display="always"/></header>
        <field name="name" string="Customer"/><field name="email" optional="show"/>
        <field name="spx_birthday_date"/><field name="spx_birthday_next"/>
        <field name="spx_birthday_countdown"/>
        <field name="spx_birthday_currency_id" column_invisible="True"/>
        <field name="spx_birthday_balance"/><field name="spx_birthday_expiry"/>
        <field name="spx_birthday_remaining"/><field name="spx_birthday_issued"/>
        <button name="action_spx_issue_birthday" type="object" string="Issue credit"/>
        <button name="action_spx_birthday_cards" type="object" string="Open native cards"/>
      </list>
    </field>
  </record>
  <record id="birthday_customer_search" model="ir.ui.view">
    <field name="name">spx.birthday.customer.search</field><field name="model">res.partner</field><field name="priority">90</field><field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
    <field name="arch" type="xml">
      <search><field name="name"/><field name="email"/>
        <filter name="birthday_today" string="Today" domain="[('spx_birthday_countdown', '=', 0)]"/>
        <filter name="birthday_soon" string="Next 30 days" domain="[('spx_birthday_countdown', '&lt;=', 30)]"/>
      </search>
    </field>
  </record>
  <record id="birthday_customers_action" model="ir.actions.server">
    <field name="name">Customer Birthdays</field><field name="model_id" ref="website.model_website"/>
    <field name="state">code</field><field name="code">action = model.action_spx_birthday_overview()</field>
  </record>
  <record id="birthday_issue_form" model="ir.ui.view">
    <field name="name">spx.birthday.issue.form</field><field name="model">spx.mobile.birthday.issue</field>
    <field name="arch" type="xml">
      <form string="Issue birthday credit">
        <group><field name="website_id" options="{'no_create': True}"/>
          <field name="partner_id" options="{'no_create': True}"/><field name="currency_id" invisible="1"/>
          <field name="amount"/><field name="days"/><field name="reason"/>
        </group>
        <p>Creates a native birthday gift card, valid from today. If credit has already been awarded this year, the existing card opens instead; no second credit is added. Use its native Update Balance action for adjustments.</p>
        <footer><button name="action_issue" type="object" string="Issue / open birthday credit" class="btn-primary"/><button special="cancel" string="Cancel" class="btn-secondary"/></footer>
      </form>
    </field>
  </record>
  <record id="birthday_issue_action" model="ir.actions.act_window">
    <field name="name">Issue Birthday Credit</field><field name="res_model">spx.mobile.birthday.issue</field><field name="view_mode">form</field><field name="target">new</field>
  </record>
  <record id="birthday_award_form" model="ir.ui.view">
    <field name="name">spx.birthday.award.form</field><field name="model">spx.mobile.birthday.award</field>
    <field name="arch" type="xml">
      <form create="0" edit="0" delete="0">
        <header><button name="action_adjust_native_balance" type="object" string="Update Balance" class="btn-primary"/>
          <button name="action_open_native_card" type="object" string="Open card / edit expiry"/>
        </header>
        <sheet><group><field name="partner_id"/><field name="website_id"/><field name="year"/>
          <field name="issued_on"/><field name="amount" string="Originally issued"/><field name="currency_id"/>
          <field name="balance" string="Current native balance"/><field name="expires"/><field name="days_remaining"/>
          <field name="card_id"/><field name="reason"/>
        </group><p>The current balance and expiry are read directly from Odoo’s native gift card. The original award record is retained for history.</p></sheet>
      </form>
    </field>
  </record>
  <record id="birthday_list" model="ir.ui.view">
    <field name="arch" type="xml">
      <list create="0" edit="0" delete="0">
        <header><button name="%(birthday_issue_action)d" type="action" string="Issue credit" display="always"/>
          <button name="%(birthday_settings_action)d" type="action" string="Birthday settings" display="always"/>
        </header>
        <field name="partner_id"/><field name="year"/><field name="issued_on"/>
        <field name="amount" string="Originally issued"/><field name="balance" string="Current balance"/>
        <field name="currency_id"/><field name="expires"/><field name="days_remaining"/><field name="website_id"/>
        <button name="action_adjust_native_balance" type="object" string="Update Balance"/>
        <button name="action_open_native_card" type="object" string="Open native card"/>
      </list>
    </field>
  </record>
  <menuitem id="mobile_birthday_customers_menu" name="Customer Birthdays" parent="mobile_engagement_menu" action="birthday_customers_action" sequence="0" groups="base.group_system"/>
  <menuitem id="mobile_birthday_settings_menu" name="Birthday Settings" parent="mobile_engagement_menu" action="birthday_settings_action" sequence="1" groups="base.group_system"/>
</odoo>
