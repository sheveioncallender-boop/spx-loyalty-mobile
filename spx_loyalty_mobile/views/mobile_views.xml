<odoo>
    <record id="website_mobile_form" model="ir.ui.view">
        <field name="name">website.form.spx.mobile</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Customer App" groups="base.group_system">
                    <group>
                        <field name="spx_mobile_enabled"/>
                        <field name="spx_mobile_brand"/>
                        <field name="spx_mobile_program_ids" widget="many2many_tags"/>
                    </group>
                    <p>Odoo manages all loyalty rules, points and rewards. Only the selected programs are visible in the customer app. Sign in with an individual customer portal account.</p>
                </page>
            </xpath>
        </field>
    </record>
    <record id="message_list" model="ir.ui.view">
        <field name="name">spx.mobile.message.list</field>
        <field name="model">spx.mobile.message</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="partner_id"/><field name="website_id"/><field name="create_date"/><field name="read_at"/><field name="email_queued"/></list>
        </field>
    </record>
    <record id="message_form" model="ir.ui.view">
        <field name="name">spx.mobile.message.form</field>
        <field name="model">spx.mobile.message</field>
        <field name="arch" type="xml">
            <form>
                <header><button name="action_email" string="Queue email" type="object" class="btn-primary" invisible="email_queued"/></header>
                <sheet><group><field name="name"/><field name="partner_id"/><field name="website_id"/><field name="body"/><field name="read_at"/><field name="email_queued"/><field name="mail_id" invisible="not mail_id"/></group></sheet>
            </form>
        </field>
    </record>
    <record id="message_action" model="ir.actions.act_window">
        <field name="name">App Messages</field><field name="res_model">spx.mobile.message</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="mobile_menu" name="Customer App" groups="base.group_system" sequence="90"/>
    <menuitem id="mobile_messages_menu" name="Messages" parent="mobile_menu" action="message_action"/>
</odoo>
