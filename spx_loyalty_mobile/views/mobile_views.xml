<odoo>
    <record id="website_mobile_form" model="ir.ui.view">
        <field name="name">website.form.spx.mobile</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Customer App" groups="base.group_system">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <img src="/spx_loyalty_mobile/static/description/icon.png" alt="Jenny's on the Boulevard" width="64" height="64" class="rounded-circle"/>
                        <div><h2 class="mb-1">Jenny’s Rewards</h2><p class="mb-0 text-muted">Customer app settings for this website</p></div>
                    </div>
                    <group>
                        <field name="spx_mobile_enabled"/>
                        <field name="spx_mobile_brand"/>
                        <field name="spx_mobile_program_ids" widget="many2many_tags"/>
                    </group>
                    <p>Odoo manages all loyalty rules, points and rewards. Only the selected programs are visible in the customer app. Sign in with an individual customer portal account.</p>
                </page>
            </xpath>
        </field>
    </record>
    <record id="message_list" model="ir.ui.view">
        <field name="name">spx.mobile.message.list</field>
        <field name="model">spx.mobile.message</field>
        <field name="arch" type="xml">
            <list string="Jenny’s Messages"><field name="name"/><field name="partner_id" string="Customer"/><field name="website_id"/><field name="create_date"/><field name="read_at"/><field name="email_queued"/></list>
        </field>
    </record>
    <record id="message_form" model="ir.ui.view">
        <field name="name">spx.mobile.message.form</field>
        <field name="model">spx.mobile.message</field>
        <field name="arch" type="xml">
            <form string="Jenny’s Message">
                <header><button name="action_email" string="Queue email" type="object" class="btn-primary" invisible="email_queued"/></header>
                <sheet><group><field name="name"/><field name="partner_id" string="Customer"/><field name="website_id"/><field name="body"/><field name="read_at"/><field name="email_queued"/><field name="mail_id" invisible="not mail_id"/></group></sheet>
            </form>
        </field>
    </record>
    <record id="message_action" model="ir.actions.act_window">
        <field name="name">Jenny’s Messages</field><field name="res_model">spx.mobile.message</field><field name="view_mode">list,form</field>
        <field name="help" type="html">
            <div class="text-center">
                <img src="/spx_loyalty_mobile/static/description/icon.png" alt="Jenny's on the Boulevard" width="88" height="88" class="rounded-circle mb-3"/>
                <h2>A personal touch from Jenny’s</h2>
                <p>Create your first customer message with New.</p>
                <p>It will appear in their app inbox. Promotional email is available for customers who have opted in.</p>
            </div>
        </field>
    </record>
    <record id="home_action" model="ir.actions.client">
        <field name="name">Jenny’s Rewards</field>
        <field name="tag">spx_loyalty_mobile.home</field>
    </record>
    <record id="customers_action" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_company', '=', False)]</field>
        <field name="context">{'default_is_company': False}</field>
    </record>
    <record id="cards_action" model="ir.actions.act_window">
        <field name="name">Loyalty Cards</field>
        <field name="res_model">loyalty.card</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('program_type', '=', 'loyalty')]</field>
    </record>
    <record id="programs_action" model="ir.actions.act_window">
        <field name="name">Loyalty Programs</field>
        <field name="res_model">loyalty.program</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('program_type', '=', 'loyalty')]</field>
        <field name="context">{'default_program_type': 'loyalty'}</field>
    </record>
    <record id="websites_action" model="ir.actions.act_window">
        <field name="name">Website Settings</field>
        <field name="res_model">website</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="mobile_menu" name="Jenny’s Rewards" groups="base.group_system" sequence="90"
              web_icon="spx_loyalty_mobile,static/description/icon.png" action="home_action"/>
    <menuitem id="mobile_home_menu" name="Overview" parent="mobile_menu" action="home_action" sequence="1"/>
    <menuitem id="mobile_customers_menu" name="Customers" parent="mobile_menu" action="customers_action" sequence="10"/>
    <menuitem id="mobile_cards_menu" name="Loyalty Cards" parent="mobile_menu" action="cards_action" sequence="20"/>
    <menuitem id="mobile_programs_menu" name="Programs" parent="mobile_menu" action="programs_action" sequence="30"/>
    <menuitem id="mobile_messages_menu" name="Messages" parent="mobile_menu" action="message_action" sequence="40"/>
    <menuitem id="mobile_settings_menu" name="Settings" parent="mobile_menu" action="websites_action" sequence="50"/>
</odoo>
