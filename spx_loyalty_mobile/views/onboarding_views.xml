<odoo>
  <record id="website_signup_form" model="ir.ui.view">
    <field name="name">website.form.spx.signup</field><field name="model">website</field>
    <field name="inherit_id" ref="spx_loyalty_mobile.website_mobile_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='spx_mobile_pos_config_id']/.." position="after">
        <group string="Member signup and email" groups="base.group_system">
          <field name="spx_mobile_signup_enabled"/>
          <field name="spx_mobile_signup_program_id" domain="[('id', 'in', spx_mobile_program_ids)]" options="{'no_create': True}"/>
          <field name="spx_mobile_mail_from"/>
          <field name="spx_mobile_account_origin" placeholder="https://jennys.spxcorp.site"/>
          <field name="spx_mobile_policy_version"/>
          <field name="spx_mobile_terms"/>
          <field name="spx_mobile_privacy"/>
        </group>
        <p>Verification and recovery messages use the outgoing mail server and the email queue. New members become portal users after verifying their email. Existing native loyalty cards and balances are preserved.</p>
      </xpath>
    </field>
  </record>
  <record id="partner_signup_form" model="ir.ui.view">
    <field name="name">res.partner.form.spx.signup</field><field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml"><xpath expr="//notebook" position="inside">
      <page string="Jenny’s Membership" groups="base.group_system"><group>
        <field name="spx_mobile_first_name"/><field name="spx_mobile_last_name"/>
        <field name="spx_mobile_birthday"/><field name="spx_mobile_verified_at"/>
        <field name="spx_mobile_email"/><field name="spx_mobile_sms"/>
        <field name="spx_mobile_terms_at"/><field name="spx_mobile_policy_version"/>
      </group></page>
    </xpath></field>
  </record>
  <record id="registration_list" model="ir.ui.view">
    <field name="name">spx.mobile.registration.list</field><field name="model">spx.mobile.registration</field>
    <field name="arch" type="xml"><list create="false" edit="false" delete="false">
      <field name="email"/><field name="kind"/><field name="state"/><field name="website_id"/>
      <field name="sent_at"/><field name="verified_at"/><field name="partner_id"/><field name="card_id"/>
    </list></field>
  </record>
  <record id="registration_form" model="ir.ui.view">
    <field name="name">spx.mobile.registration.form</field><field name="model">spx.mobile.registration</field>
    <field name="arch" type="xml"><form create="false" edit="false" delete="false"><sheet><group>
      <field name="email"/><field name="kind"/><field name="state"/><field name="website_id"/>
      <field name="first_name"/><field name="last_name"/><field name="phone"/><field name="birthday"/><field name="city"/>
      <field name="marketing_email"/><field name="marketing_sms"/><field name="policy_version"/><field name="terms_at"/>
      <field name="sent_at"/><field name="expires_at"/><field name="verified_at"/>
      <field name="user_id"/><field name="partner_id"/><field name="card_id"/><field name="mail_id"/>
    </group></sheet></form></field>
  </record>
  <record id="registration_action" model="ir.actions.act_window">
    <field name="name">Member Registrations</field><field name="res_model">spx.mobile.registration</field><field name="view_mode">list,form</field>
  </record>
  <menuitem id="mobile_registration_menu" name="Registrations" parent="spx_loyalty_mobile.mobile_menu" action="registration_action" sequence="15" groups="base.group_system"/>
</odoo>
