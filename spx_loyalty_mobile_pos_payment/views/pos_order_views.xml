<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_order_refund_loyalty" model="ir.ui.view">
        <field name="name">pos.order.refund.loyalty</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_spx_reconcile_refund_loyalty" type="object"
                        string="Reconcile Refund Points"
                        groups="point_of_sale.group_pos_manager"
                        invisible="state not in ['paid', 'done', 'invoiced'] or not refunded_order_id"/>
            </xpath>
        </field>
    </record>
</odoo>
