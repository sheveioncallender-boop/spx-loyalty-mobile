<odoo>
    <record id="message_company_rule" model="ir.rule">
        <field name="name">Mobile messages: allowed companies</field>
        <field name="model_id" ref="model_spx_mobile_message"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="birthday_company_rule" model="ir.rule"><field name="name">Birthday credits: allowed companies</field><field name="model_id" ref="model_spx_mobile_birthday_award"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="announcement_company_rule" model="ir.rule"><field name="name">Announcements: allowed companies</field><field name="model_id" ref="model_spx_mobile_announcement"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="gift_delivery_company_rule" model="ir.rule"><field name="name">Gift delivery: allowed companies</field><field name="model_id" ref="model_spx_mobile_gift_delivery"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
</odoo>
